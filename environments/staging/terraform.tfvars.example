# AWS region
region = "ap-southeast-1"

# SSH key 
key_name        = "k0s-key"
public_key_path = "../../../key_pair/k0s_key.pub"

# Networking
vpc_cidr = "10.0.0.0/16"
vpn_cidr = "10.8.0.0/24"

az_count = 3

subnet_newbits = 8

public_subnet_indexes = [1, 2, 3]
k8s_subnet_indexes    = [11, 12, 13]
observ_subnet_indexes = [21]

openvpn_public_subnet_index = 2

k0s_nodes = {
  master = {
    subnet_index = 0
    private_ip   = "10.0.11.10"
  }

  worker1 = {
    subnet_index = 0
    private_ip   = "10.0.11.11"
  }

  worker2 = {
    subnet_index = 1
    private_ip   = "10.0.12.10"
  }

  worker3 = {
    subnet_index = 2
    private_ip   = "10.0.13.10"
  }
}

observability_nodes = {
  obser_01 = {
    subnet_index = 0
    private_ip   = "10.0.21.10"
  }

  # obser_02 = {
  #   subnet_index = 1
  #   private_ip   = "10.0.22.10"
  # }
}

# =========================
# Compute
# =========================
# AMI is set manually for Learner Lab IAM restrictions
# (DescribeImages is blocked, so provide a fixed ami_id below)

# Instance Type 
k0s_instance_type           = "t3.small"
observability_instance_type = "t3.small"
openvpn_instance_type       = "t3.micro"

# Ansible
ansible_inventory_dir = "../../../ansible-hub/inventories/staging"

# Application Load Balancer
alb_target_port = 30293
environment     = "staging"

# Root disk for k0s nodes (GiB)
k0s_root_volume_size = 30

# Static AZ list for restricted Learner Lab IAM (no DescribeAvailabilityZones)
az_names = ["ap-southeast-1a", "ap-southeast-1b", "ap-southeast-1c"]

# Set a valid AMI ID in ap-southeast-1 (Ubuntu 22.04 recommended)
ami_id = "ami-REPLACE_ME"
